{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "dev": "pnpm with-env tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm with-env prisma generate",
    "db:deploy": "pnpm with-env prisma migrate deploy",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:push": "pnpm with-env prisma db push",
    "db:studio": "pnpm with-env prisma studio",
    "start": "pnpm with-env tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.26",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "@repo/logger": "workspace:*",
    "better-auth": "^1.6.26",
    "hono": "^4.13.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
