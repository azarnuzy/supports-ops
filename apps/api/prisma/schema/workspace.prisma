model Workspace {
  id                 String             @id
  name               String
  slug               String             @unique
  closingMessage     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  users              User[]
  aiAgents           AiAgent[]
  channels           Channel[]
  customerIdentities CustomerIdentity[]
  sessions           Session[]
  tickets            Ticket[]
  attachments        Attachment[]
  knowledgeSources   KnowledgeSource[]
  chunks             Chunk[]
  aiSettings         AiSettings?
  tools              Tool[]
  toolAssignments    ToolAssignment[]
  mcpServers         McpServer[]
  mcpTools           McpTool[]
  ticketCategories   TicketCategory[]
}

/// Ticket categories are per-Workspace so a team can name them after its own product.
/// `key` is what Tickets store, so renaming a category never orphans them.
/// Exactly one category per Workspace is the fallback: it catches anything the classifier is
/// unsure about, and it cannot be deleted.
model TicketCategory {
  id          String    @id
  workspaceId String
  key         String
  label       String
  description String
  isFallback  Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
}

model AiSettings {
  id                      String    @id
  workspaceId             String    @unique
  followUpAfterSeconds    Int       @default(900)
  autoResolveAfterSeconds Int       @default(3600)
  autoResolveEnabled      Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  workspace               Workspace @relation(fields: [workspaceId], references: [id])
}

model AiAgent {
  id          String        @id
  workspaceId String
  name        String
  status      AiAgentStatus @default(ACTIVE)
  instructions      String?
  handoffMessage    String?
  resolutionMessage String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  channels    Channel[]
  tickets     Ticket[]
  toolAssignments ToolAssignment[]

  @@index([workspaceId])
  @@unique([workspaceId, id])
}
