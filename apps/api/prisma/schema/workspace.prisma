model Workspace {
  id                 String             @id
  name               String
  slug               String             @unique
  closingMessage     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  users              User[]
  aiAgents           AiAgent[]
  channels           Channel[]
  customerIdentities CustomerIdentity[]
  webSessions        WebSession[]
  tickets            Ticket[]
  attachments        Attachment[]
  knowledgeSources   KnowledgeSource[]
  chunks             Chunk[]
}

model AiAgent {
  id          String        @id
  workspaceId String
  name        String
  status      AiAgentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  channels    Channel[]

  @@index([workspaceId])
}
