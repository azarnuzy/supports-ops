model Ticket {
  id                 String           @id
  workspaceId        String
  channelId          String
  aiAgentId          String
  sessionId          String           @unique
  customerIdentityId String
  title              String
  category           String           @default("GENERAL")
  priority           TicketPriority   @default(NORMAL)
  status             TicketStatus     @default(AI_HANDLING)
  escalationReason   EscalationReason?
  escalatedAt        DateTime?
  escalationSummary  String?
  escalationSummaryStatus EscalationSummaryStatus @default(PENDING)
  assignedHumanAgentId String?
  resolvedBy           String?
  resolutionReason     ResolutionReason?
  resolvedAt           DateTime?
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id])
  channel            Channel          @relation(fields: [workspaceId, channelId], references: [workspaceId, id])
  aiAgent            AiAgent          @relation(fields: [workspaceId, aiAgentId], references: [workspaceId, id])
  session            Session          @relation(fields: [sessionId], references: [id])
  customerIdentity   CustomerIdentity @relation(fields: [customerIdentityId], references: [id])
  assignedHumanAgent User?           @relation("TicketAssignee", fields: [assignedHumanAgentId], references: [id])
  messages           Message[]
  attachments        Attachment[]
  aiActivities       AiActivity[]
  readStates         TicketReadState[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, assignedHumanAgentId, createdAt])
  @@index([workspaceId, customerIdentityId])
  @@index([workspaceId, aiAgentId])
}

/** Tracks, per Workspace user, the last Message position they have read on a
 * Ticket. Position is the same monotonic counter as Session.messageSeq, so
 * unread counts compare directly against it without loading transcripts. */
model TicketReadState {
  id               String   @id
  workspaceId      String
  ticketId         String
  userId           String
  lastReadPosition Int      @default(0)
  updatedAt        DateTime @updatedAt
  ticket           Ticket   @relation(fields: [ticketId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
  @@index([workspaceId, userId])
}

model Attachment {
  id               String                     @id
  workspaceId      String
  ticketId         String
  messageId        String
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  processingStatus AttachmentProcessingStatus @default(PROCESSING)
  extractedText    String?
  failureReason    String?
  createdAt        DateTime                   @default(now())
  deletedAt        DateTime?
  deletedBy        String?
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id])
  ticket           Ticket                     @relation(fields: [ticketId], references: [id])
  message          Message                    @relation(fields: [messageId], references: [id])

  @@index([ticketId, processingStatus])
  @@index([messageId])
}

model AiActivity {
  id          String         @id
  workspaceId String
  ticketId    String
  eventType   AiActivityType
  metadata    Json
  createdAt   DateTime       @default(now())
  ticket      Ticket         @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}
