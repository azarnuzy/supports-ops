model Ticket {
  id                 String           @id
  workspaceId        String
  channelId          String
  webSessionId       String           @unique
  customerIdentityId String
  title              String
  category           TicketCategory   @default(GENERAL)
  priority           TicketPriority   @default(NORMAL)
  status             TicketStatus     @default(AI_HANDLING)
  escalationReason   EscalationReason?
  escalatedAt        DateTime?
  escalationSummary  String?
  escalationSummaryStatus EscalationSummaryStatus @default(PENDING)
  assignedHumanAgentId String?
  resolvedBy           String?
  resolutionReason     ResolutionReason?
  resolvedAt           DateTime?
  messageSeq         Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id])
  channel            Channel          @relation(fields: [channelId], references: [id])
  webSession         WebSession       @relation(fields: [webSessionId], references: [id])
  customerIdentity   CustomerIdentity @relation(fields: [customerIdentityId], references: [id])
  assignedHumanAgent User?           @relation("TicketAssignee", fields: [assignedHumanAgentId], references: [id])
  conversation       Conversation?
  messages           Message[]
  attachments        Attachment[]
  aiActivities       AiActivity[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, assignedHumanAgentId, createdAt])
  @@index([workspaceId, customerIdentityId])
}

model Attachment {
  id               String                     @id
  workspaceId      String
  ticketId         String
  messageId        String
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  processingStatus AttachmentProcessingStatus @default(PROCESSING)
  extractedText    String?
  failureReason    String?
  createdAt        DateTime                   @default(now())
  deletedAt        DateTime?
  deletedBy        String?
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id])
  ticket           Ticket                     @relation(fields: [ticketId], references: [id])
  message          Message                    @relation(fields: [messageId], references: [id])

  @@index([ticketId, processingStatus])
  @@index([messageId])
}

model AiActivity {
  id          String         @id
  workspaceId String
  ticketId    String
  eventType   AiActivityType
  metadata    Json
  createdAt   DateTime       @default(now())
  ticket      Ticket         @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}
