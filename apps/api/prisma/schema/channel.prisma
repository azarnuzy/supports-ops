model Channel {
  id              String           @id
  workspaceId     String
  aiAgentId       String
  type            ChannelType
  name            String
  status          ChannelStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  aiAgent         AiAgent          @relation(fields: [aiAgentId], references: [id])
  webWidgetConfig WebWidgetConfig?
  webSessions     WebSession[]
  tickets         Ticket[]

  @@unique([workspaceId, type])
  @@index([workspaceId])
}

model CustomerIdentity {
  id                 String       @id
  workspaceId        String
  channelType        ChannelType
  name               String
  email              String
  externalCustomerId String?
  createdAt          DateTime     @default(now())
  deletedAt          DateTime?
  workspace          Workspace    @relation(fields: [workspaceId], references: [id])
  webSessions        WebSession[]
  tickets            Ticket[]

  @@index([workspaceId, channelType, email])
}

model WebSession {
  id                 String           @id
  workspaceId        String
  channelId          String
  customerIdentityId String
  accessToken        String           @unique
  status             WebSessionStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  closedAt           DateTime?
  workspace          Workspace        @relation(fields: [workspaceId], references: [id])
  channel            Channel          @relation(fields: [channelId], references: [id])
  customerIdentity   CustomerIdentity @relation(fields: [customerIdentityId], references: [id])
  ticket             Ticket?

  @@index([workspaceId])
  @@index([channelId])
  @@index([customerIdentityId])
}

model WebWidgetConfig {
  id             String   @id
  workspaceId    String
  channelId      String   @unique
  widgetKey      String   @unique
  botName        String
  welcomeMessage String
  primaryColor   String
  allowedDomains String[]
  logoKey        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  channel        Channel  @relation(fields: [channelId], references: [id])

  @@index([workspaceId])
}
