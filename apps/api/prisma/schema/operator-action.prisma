model OperatorAction {
  id          String @id
  operatorId  String
  workspaceId String
  type        OperatorActionType
  payload     Json
  createdAt   DateTime @default(now())
  operator    Operator @relation(fields: [operatorId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

/// A dated window (ADR-0025) in which a Workspace's AI Turns and Follow-Ups spend
/// no Credits. At most one is active per Workspace: active means `endedEarlyAt`
/// is null and `endAt` is in the future. Periods for a Workspace never overlap,
/// so the latest one by `createdAt` is always its current-or-most-recent period.
model UnlimitedPeriod {
  id           String    @id
  workspaceId  String
  operatorId   String
  startAt      DateTime  @default(now())
  endAt        DateTime
  endedEarlyAt DateTime?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  operator     Operator  @relation(fields: [operatorId], references: [id])

  @@index([workspaceId, createdAt])
}
