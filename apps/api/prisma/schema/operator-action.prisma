model OperatorAction {
  id          String @id
  operatorId  String
  workspaceId String
  type        OperatorActionType
  payload     Json
  createdAt   DateTime @default(now())
  operator    Operator @relation(fields: [operatorId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

/// A window in which every Workspace of an Organization spends no Credits.
/// An Organization-wide window; Operator Actions separately retain their Workspace anchor.
model UnlimitedPeriod {
  id           String    @id
  organizationId String
  operatorId   String
  startAt      DateTime  @default(now())
  endAt        DateTime?
  endedEarlyAt DateTime?
  createdAt    DateTime  @default(now())
  organization Organization @relation(fields: [organizationId], references: [id])
  operator     Operator  @relation(fields: [operatorId], references: [id])

  @@index([organizationId, createdAt])
}
