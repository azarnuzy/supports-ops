model OperatorAction {
  id          String @id
  operatorId  String
  workspaceId String
  type        OperatorActionType
  payload     Json
  createdAt   DateTime @default(now())
  operator    Operator @relation(fields: [operatorId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

/// A window in which every Workspace of an Organization spends no Credits.
/// workspaceId anchors legacy history and Operator Actions to the original Workspace;
/// eligibility and overlap are determined through its Organization.
model UnlimitedPeriod {
  id           String    @id
  workspaceId  String
  operatorId   String
  startAt      DateTime  @default(now())
  endAt        DateTime?
  endedEarlyAt DateTime?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  operator     Operator  @relation(fields: [operatorId], references: [id])

  @@index([workspaceId, createdAt])
}
