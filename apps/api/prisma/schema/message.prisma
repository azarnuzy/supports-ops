/** The AI Agent's memory store. Created when a Session opens, so the Agent
 * remembers the conversation from its first turn. `sessionId` is both Anvia's
 * memory scope and the foreign key to our Session — one identifier, one
 * conversation. See ADR-0017. */
model Conversation {
  id          String    @id
  scopeKey    String    @unique
  sessionId   String    @unique
  userId      String
  metadata    Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  session     Session   @relation(fields: [sessionId], references: [id])
  messages    Message[]
}

model Message {
  id                String                @id
  memorySessionId   String
  runId             String
  turn              Int
  position          Int
  role              String
  message           Json
  createdAt         DateTime              @default(now())
  workspaceId       String
  ticketId          String?
  sessionId         String
  senderType        MessageSenderType
  senderUserId      String?
  content           String
  externalMessageId String
  deliveryStatus    MessageDeliveryStatus @default(SENT)
  deliveryAttempts  Int                   @default(0)
  deletedAt         DateTime?
  deletedBy         String?
  conversation      Conversation          @relation(fields: [memorySessionId], references: [id])
  ticket            Ticket?               @relation(fields: [ticketId], references: [id])
  session           Session               @relation(fields: [sessionId], references: [id])
  attachments       Attachment[]

  @@unique([sessionId, position])
  @@unique([workspaceId, externalMessageId])
  @@index([ticketId, position])
  @@index([memorySessionId, position])
  @@index([runId])
}
