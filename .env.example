# Copy this file to .env.local for direct local development. The root .env is
# reserved for production settings used by Docker Compose and start commands.
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/supportops?schema=public"
BUSINESS_SYSTEM_DATABASE_URL="postgresql://postgres:postgres@localhost:15432/supportops?schema=business_system"
BUSINESS_SYSTEM_URL="http://localhost:8001"
API_INTERNAL_URL="http://localhost:8000"
INTERNAL_WORKER_TOKEN=""
REDIS_URL="redis://localhost:16379"
SESSION_LINK_BASE_URL="http://localhost:8000/widget/session"
SMTP_URL="smtp://localhost:1025"
RESEND_API_KEY=""
EMAIL_FROM="SupportOps <support@example.com>"
DOCKER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/supportops?schema=public"
API_HOST_PORT="8000"
BUSINESS_SYSTEM_HOST_PORT="8001"
VITE_API_URL="http://localhost:8000"
VITE_WIDGET_URL="http://localhost:3002"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8000"
CLIENT_ORIGINS="http://localhost:3000,http://localhost:4000"
# Agent and application telemetry — see docs/setup/06-observability.md.
ENABLE_TELEMETRY="false"
TELEMETRY_EXPORTER="console"
TELEMETRY_CAPTURE_MODE="safe"
TELEMETRY_EXPORTER_OTLP_ENDPOINT=""
TELEMETRY_API_KEY=""
TELEMETRY_API_KEY_HEADER="authorization"
TELEMETRY_SERVICE_NAMESPACE="supportops"
S3_BUCKET="supportops"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL=""
OPENROUTER_API_KEY=""
EMBEDDING_MODEL="openai/text-embedding-3-small"
LLM_MODEL_FAST="openai/gpt-4.1-nano"
# Reasoning effort and output-token ceiling for the reply model. Chosen from
# measurement, not guessed — see docs/research/ai-agent-cost-and-latency.md
# §1b before changing either. Reasoning effort is part of the prompt-cache
# key, so changing it invalidates the warm cache on the next turn.
LLM_MAIN_REASONING_EFFORT="low"
LLM_MAIN_MAX_OUTPUT_TOKENS="1024"
# Completions may run through a different gateway than embeddings.
# Leave blank to keep both on OpenRouter.
COMPLETION_GATEWAY_BASE_URL=""
COMPLETION_GATEWAY_API_KEY=""
# Eval suite: judge model and the Workspace the suite runs against.
EVAL_JUDGE_MODEL=""
EVAL_WORKSPACE_ID=""
# Base64-encoded 32-byte key, e.g. `openssl rand -base64 32`.
TOOL_MASTER_KEY=""
# Development only. Production HTTP Tools always require HTTPS.
ALLOW_LOCAL_HTTP_TOOLS="false"
MISTRAL_API_KEY=""
TAVILY_API_KEY=""
