POSTGRES_USER=supportops
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=supportops
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INTERNAL_WORKER_TOKEN=replace-with-a-long-random-token
TOOL_MASTER_KEY=replace-with-base64-encoded-32-byte-key

EMAIL_FROM=SupportOps <support@example.com>
RESEND_API_KEY=re_replace_with_resend_api_key

OPENROUTER_API_KEY=replace-with-openrouter-api-key
MISTRAL_API_KEY=
TAVILY_API_KEY=

S3_BUCKET=supportops
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Optional runtime configuration
LOG_LEVEL=info
ENABLE_TELEMETRY=false
TELEMETRY_EXPORTER=console
TELEMETRY_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_API_KEY=
TELEMETRY_API_KEY_HEADER=authorization
TELEMETRY_SERVICE_NAMESPACE=supportops
