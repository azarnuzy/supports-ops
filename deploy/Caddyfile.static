:80 {
	encode zstd gzip

	root * /srv

	# Vite writes a content hash into every asset filename, so a cached copy can
	# never be stale. index.html stays uncached so a deploy is picked up at once.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
