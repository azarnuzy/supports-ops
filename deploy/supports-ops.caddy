support.azarnuzy.com {
	reverse_proxy supports-ops-platform:80
}

api.support.azarnuzy.com {
	# JSON only: an SSE stream must not be buffered by the encoder, and the
	# Ticket and Knowledge event endpoints serve text/event-stream.
	encode {
		zstd
		gzip
		match header Content-Type application/json*
	}
	reverse_proxy supports-ops-api:8000
}

widget.support.azarnuzy.com {
	reverse_proxy supports-ops-widget:80
}
