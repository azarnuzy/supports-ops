{
  "name": "monorepo-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "deploy:admin": "pnpm --filter @repo/admin deploy",
    "deploy:platform": "pnpm --filter @repo/platform deploy",
    "build": "pnpm --filter './apps/*' build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "with-env": "dotenv -e .env --",
    "createsuperuser": "pnpm with-env tsx scripts/createsuperuser.ts",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:deploy": "pnpm --filter @repo/api db:deploy",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:push": "pnpm --filter @repo/api db:push",
    "db:studio": "pnpm --filter @repo/api db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
